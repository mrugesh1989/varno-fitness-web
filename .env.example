# Contact form — Web3Forms (https://web3forms.com)
#
# 1. Go to https://web3forms.com → "Create Access Key" → enter
#    varnofitness@gmail.com (the inbox that will receive submissions).
# 2. Confirm the email Web3Forms sends, then copy your Access Key here.
# 3. Copy this file to `.env.local` (which is gitignored) and paste your real
#    key there. Never commit a real key in `.env.example`.
#
# Web3Forms is a static-friendly form-to-email service. The access key is
# embedded in the client bundle at build time. Web3Forms rate-limits per key
# and per inbox, but treat it like a publishable token: prefer keeping it out
# of committed files. For production deploys, the same value is also stored
# as the `NEXT_PUBLIC_WEB3FORMS_KEY` GitHub Actions secret.

NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# Optional: override the canonical site URL or sub-path used by the static
# export. Defaults to the GitHub Pages project URL; clear them when moving
# to the custom domain (see docs/HOSTING_AND_DNS.md, Part C).
# NEXT_PUBLIC_SITE_URL=https://varnofitness.com
# NEXT_PUBLIC_BASE_PATH=
